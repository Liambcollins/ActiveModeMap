@@ -14,9 +14,45 @@ from activemodemap.lowrank import band_mask, resonance_index, classify_null_from
 from config import DENSE_GRID_A
 D=str(DENSE_GRID_A)
 BANDS=dict(A=(270e3,450e3), B=(860e3,1300e3))
+#: Phase convention of the stored spectra.  DenseReference.npz was written by
+#: series.save_checkpoint before 2026-09-17 with Z = amp*exp(+i*phase_igor);
+#: the Cypher phase INCREASES through resonance (+132 deg on Grid_A), while
+#: every EB/FEM library here has the phase DECREASING (-159 deg).  Fitting the
+#: raw Z therefore compares the model to the complex CONJUGATE of the data --
+#: the 42.4 deg / 142 % "structural phase failure" in the README, and the
+#: reason cplxrec._gain had to avoid the complex least-squares gain.  Files
+#: carrying a 'phase_convention' tag are honoured; untagged files are treated
+#: as igor-raw and conjugated.  See activemodemap.asylum.PHASE_SIGN.
+MODEL_PHASE_CONVENTION = 'model'
+
+
+def phase_slope_through_peak(freq, amp, phase_deg, width_factor=2.0):
+    """Unwrapped phase change (deg) across the strongest peak; >0 = increasing."""
+    from activemodemap.asylum import phase_slope_through_peak as _p
+    return _p(freq, amp, phase_deg, width_factor=width_factor)
+
+
+def to_model_convention(Z, tag=None, freq=None, verbose=True):
+    """Return Z in the forward models' phase convention (phase decreasing
+    through resonance).  `tag` is the checkpoint's 'phase_convention' entry
+    when present; None means igor-raw."""
+    tag = 'igor-raw' if tag is None else str(tag)
+    if tag == MODEL_PHASE_CONVENTION:
+        return Z
+    if freq is not None and verbose:
+        i = int(np.argmax(np.abs(Z).max(axis=1)))
+        s = phase_slope_through_peak(freq, np.abs(Z[i]), np.degrees(np.angle(Z[i])))
+        if np.isfinite(s) and s < 0:
+            print(f'  ** setup_data: stored spectra already have the model convention '
+                  f'({s:+.0f} deg through the peak) but carry tag {tag!r}; NOT conjugating')
+            return Z
+    return np.conj(Z)
+
+
 def load(mode='A', axis='calibrated'):
     dn=np.load(D+'/DenseReference.npz',allow_pickle=True)
     x=dn['x_um'].astype(float); f=dn['freq_Hz']; Z=dn['Z']
+    Z=to_model_convention(Z, dn['phase_convention'] if 'phase_convention' in dn.files else None, f)
     bm=band_mask(f,BANDS[mode]); f=f[bm]; Z=Z[:,bm]
     if axis=='calibrated':
         dl=pd.read_csv(D+'/DenseReference_log.csv',parse_dates=['timestamp'])
